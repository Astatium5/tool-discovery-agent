<idea-plugin>
    <id>com.tooldiscovery.agent</id>
    <name>Tool Discovery Agent</name>
    <vendor url="https://github.com/Astatium5/tool-discovery-agent">Tool Discovery</vendor>

    <description><![CDATA[
    <p>Tool Discovery Agent for IntelliJ IDEA</p>
    <p>Discovers and interacts with IDE development tools through GUI perception.</p>
    <ul>
        <li>Discover available refactoring and analysis tools</li>
        <li>Plan and execute automated refactoring operations</li>
        <li>LLM-powered reasoning and action generation</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
    </extensions>

    <actions>
        <group id="ToolDiscovery.Actions" text="Tool Discovery" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="first"/>

            <action id="ToolDiscovery.LaunchAgent"
                    class="execution.LaunchAgentAction"
                    text="Launch Agent"
                    description="Start the Tool Discovery Agent"
                    icon="AllIcons.Actions.Find"/>

            <action id="ToolDiscovery.RunTest"
                    class="execution.RunTestAction"
                    text="Run Test Script"
                    description="Execute the test script in TestScript.kt"
                    icon="AllIcons.Actions.Execute"/>

            <action id="ToolDiscovery.RunRenameTest"
                    class="execution.RunRenameTestAction"
                    text="Test Rename Refactoring"
                    description="Run the in-process Rename refactoring test"
                    icon="AllIcons.Actions.Execute"/>

            <action id="ToolDiscovery.RunChangeSignatureVisibilityTest"
                    class="execution.RunChangeSignatureVisibilityTestAction"
                    text="Test Change Signature · Visibility"
                    description="Change a private method's visibility with Change Signature"
                    icon="AllIcons.Actions.Execute"/>

            <action id="ToolDiscovery.RunChangeSignatureNameTest"
                    class="execution.RunChangeSignatureNameTestAction"
                    text="Test Change Signature · Name"
                    description="Change a private method's name with Change Signature"
                    icon="AllIcons.Actions.Execute"/>

            <action id="ToolDiscovery.RunChangeSignatureReturnTypeTest"
                    class="execution.RunChangeSignatureReturnTypeTestAction"
                    text="Test Change Signature · Return Type"
                    description="Change a private method's return type with Change Signature"
                    icon="AllIcons.Actions.Execute"/>

            <action id="ToolDiscovery.RunChangeSignatureParametersTest"
                    class="execution.RunChangeSignatureParametersTestAction"
                    text="Test Change Signature · Parameters"
                    description="Change a private method's parameter name with Change Signature"
                    icon="AllIcons.Actions.Execute"/>
        </group>
    </actions>
</idea-plugin>
